# Copia este archivo como ".env" y completa tus valores.
# NUNCA subas el archivo .env a git ni lo compartas.
DISCORD_TOKEN=
GUILD_ID=
# Opcional: ruta del archivo SQLite (por defecto ./nca-bot.db junto a index.js)
# DB_PATH=
# Opcional: horario del recordatorio de guerra (formato cron).
# Por defecto: 17:00 America/Chicago los miércoles, viernes y sábados.
# WAR_REMINDER_CRON=0 17 * * 3,5,6
# Opcional: horario del MVP semanal (formato cron).
# Por defecto: domingos 18:00 America/Chicago.
# MVP_CRON=0 18 * * 0
# Opcional: horario del rol "Élite Semanal" automático (formato cron).
# Por defecto: lunes 06:00 America/Chicago. Asigna el rol "Élite Semanal"
# (debe existir en el servidor) a los 3 primeros de la tabla de la semana anterior.
# ELITE_CRON=0 6 * * 1
